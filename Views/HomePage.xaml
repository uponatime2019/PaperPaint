<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperPaint.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource PaperBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  hero  -->
        <StackPanel
            Margin="40"
            Orientation="Horizontal"
            Spacing="16">
            <Border
                Width="64"
                Height="64"
                VerticalAlignment="Center"
                Background="{StaticResource AccentSoftBrush}"
                CornerRadius="16">
                <FontIcon
                    FontSize="30"
                    Foreground="{StaticResource AccentBrush}"
                    Glyph="&#xE790;" />
            </Border>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="2">
                <TextBlock
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{StaticResource InkBrush}"
                    Text="Paper Paint" />
                <TextBlock
                    FontSize="14"
                    Foreground="{StaticResource SubtleBrush}"
                    Text="Paint, color and play — pen, pencil, watercolor, oil and pastel on a textured page."
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="28,24,28,32"
                HorizontalAlignment="Center"
                Spacing="8">
                <!--  action cards  -->
                <TextBlock Style="{StaticResource SectionText}" Text="Start something new" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="New painting"
                        Click="NewPainting_Click"
                        Style="{StaticResource CardButton}">
                        <StackPanel
                            Margin="2"
                            Orientation="Vertical"
                            Spacing="8">
                            <FontIcon
                                FontSize="22"
                                Foreground="{StaticResource AccentBrush}"
                                Glyph="&#xE710;" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="New Painting" />
                                <TextBlock
                                    Style="{StaticResource SubText}"
                                    Text="A fresh blank page"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Import photo"
                        Click="ImportPhoto_Click"
                        Style="{StaticResource CardButton}">
                        <StackPanel
                            Margin="2"
                            Orientation="Vertical"
                            Spacing="8">
                            <FontIcon
                                FontSize="22"
                                Foreground="{StaticResource BlueBrush}"
                                Glyph="&#xE8B9;" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Import Photo" />
                                <TextBlock
                                    Style="{StaticResource SubText}"
                                    Text="Turn a picture into paint"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Camera"
                        Click="Camera_Click"
                        Style="{StaticResource CardButton}">
                        <StackPanel
                            Margin="2"
                            Orientation="Vertical"
                            Spacing="8">
                            <FontIcon
                                FontSize="22"
                                Foreground="{StaticResource GreenBrush}"
                                Glyph="&#xE722;" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Camera" />
                                <TextBlock
                                    Style="{StaticResource SubText}"
                                    Text="Snap and paint on it"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Coloring pages"
                        Click="ColoringPages_Click"
                        Style="{StaticResource CardButton}">
                        <StackPanel
                            Margin="2"
                            Orientation="Vertical"
                            Spacing="8">
                            <FontIcon
                                FontSize="22"
                                Foreground="{StaticResource WetBrush}"
                                Glyph="&#xE8D3;" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Coloring Pages" />
                                <TextBlock
                                    Style="{StaticResource SubText}"
                                    Text="Original line art to color"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="My artwork"
                        Click="MyArtwork_Click"
                        Style="{StaticResource CardButton}">
                        <StackPanel
                            Margin="2"
                            Orientation="Vertical"
                            Spacing="8">
                            <FontIcon
                                FontSize="22"
                                Foreground="{StaticResource InkBrush}"
                                Glyph="&#xE8B9;" />
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="My Artwork" />
                                <TextBlock
                                    Style="{StaticResource SubText}"
                                    Text="Reopen saved paintings"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  recent works  -->
                <StackPanel
                    x:Name="RecentSection"
                    Orientation="Vertical"
                    Spacing="10"
                    Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionText}" Text="Recent artwork" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        VerticalScrollMode="Disabled">
                        <StackPanel
                            x:Name="RecentList"
                            Orientation="Horizontal"
                            Spacing="12" />
                    </ScrollViewer>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
