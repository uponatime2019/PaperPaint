<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PaperPaint.Views.ArtworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PaperPaint.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PaperBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="28,16,28,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                    <TextBlock Text="My Artwork" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="CountText" Text="" Style="{StaticResource SubText}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PillButton}" Click="NewPainting_Click" VerticalAlignment="Center"
                        AutomationProperties.Name="New painting">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="New Painting"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- grid -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,10,28,24">
            <Grid>
                <GridView
                    x:Name="ArtworkGrid"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="ArtworkGrid_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:ArtworkCard">
                            <StackPanel Width="224" Margin="0,0,0,10">
                                <Border CornerRadius="10" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="5">
                                    <Grid>
                                        <Image Source="{x:Bind Thumb}" Width="210" Height="158" Stretch="UniformToFill"/>
                                        <Button Width="32" Height="32" CornerRadius="6" Padding="0"
                                                Background="#B3FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4"
                                                AutomationProperties.Name="More options for painting"
                                                Click="MoreButton_Click">
                                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Rename" Click="RenameItem_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8AC;" FontSize="14"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Delete" Click="DeleteItem_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{x:Bind Item.Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" Margin="4,8,4,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="14" Foreground="{StaticResource SubtleBrush}" Margin="4,1,4,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel x:Name="EmptyState" Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" Margin="0,80,0,0">
                    <FontIcon Glyph="&#xE8B9;" FontSize="42" Foreground="{StaticResource SubtleBrush}"/>
                    <TextBlock Text="Nothing painted yet" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Create your first painting and it will show up here." Style="{StaticResource SubText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
